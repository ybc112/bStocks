# bStocks Launchpad frontend config
# 本地开发: 复制为 .env.local 使用
# 部署到 Vercel: 在 Vercel 项目 → Settings → Environment Variables 中配置(带 VITE_ 前缀的变量会被编译进前端)

# 链: 56 = BSC 主网(默认), 97 = BSC 测试网
VITE_CHAIN_ID=97

# LaunchpadFactory 合约地址 (测试网: 0x95e3358f860997E8F365d0b7f7DddE11C7A79819)
VITE_FACTORY_ADDRESS=0x95e3358f860997E8F365d0b7f7DddE11C7A79819

# 可选自定义 RPC (默认按链自动选择)
# VITE_RPC_URL=https://bsc-testnet.publicnode.com

# 后端服务地址 (靓号搜索 + BSCScan 自动验证) —— 后端部署在你自己的服务器上, 不在 Vercel
# - 本地开发: http://localhost:3001
# - 生产环境(Vercel): 改成你自己服务器上后端服务的公开 HTTPS 地址, 例如 https://api.yourdomain.com
VITE_API_BASE=http://localhost:3001

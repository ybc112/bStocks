# bStocks Launchpad frontend config
# Copy to .env.local (dev) or set in Vercel project settings

# Chain: 56 = BSC mainnet (default), 97 = BSC testnet
VITE_CHAIN_ID=97

# LaunchpadFactory contract address (testnet: 0x95e3358f860997E8F365d0b7f7DddE11C7A79819)
VITE_FACTORY_ADDRESS=0x95e3358f860997E8F365d0b7f7DddE11C7A79819

# Optional custom RPC (defaults per chain)
# VITE_RPC_URL=https://bsc-testnet.publicnode.com

# Backend service base URL (vanity salt search + BscScan auto verification)
VITE_API_BASE=http://localhost:3001

# bStocks Launchpad frontend config
# 本地开发: 复制为 .env.local 使用
# 部署到 Vercel: 在 Vercel 项目 → Settings → Environment Variables 中配置(带 VITE_ 前缀的变量会被编译进前端)

# 链: 56 = BSC 主网(默认), 97 = BSC 测试网
VITE_CHAIN_ID=97

# LaunchpadFactory 合约地址 (测试网: 0x3F858D134E6ba1aE4F3BE88A5B000d2373acf82c)
VITE_FACTORY_ADDRESS=0x3F858D134E6ba1aE4F3BE88A5B000d2373acf82c

# 可选自定义 RPC (默认按链自动选择)
# VITE_RPC_URL=https://bsc-testnet.publicnode.com

# 后端服务地址 (靓号搜索 + BSCScan 自动验证) —— 后端部署在自有服务器 (Nginx+HTTPS, 不在 Vercel)
# - 本地开发: http://localhost:3001 (或留空会默认走生产域名)
# - 生产环境: https://bstocks-api.dogau1413.com
VITE_API_BASE=https://bstocks-api.dogau1413.com

# bStocks Launchpad backend config (copy to .env on your server)

# Etherscan V2 API key (works for BSC mainnet + testnet)
BSCSCAN_API_KEY=your_etherscan_v2_api_key

# Chain: 97 = BSC testnet, 56 = BSC mainnet
CHAIN_ID=97

# Server port
PORT=3001

# LaunchpadFactory + TokenDeployer addresses (for /api/config)
FACTORY_ADDRESS=0xA9EE5CF589c848fd6d27bf8F85c7f0997085912a
DEPLOYER_ADDRESS=0xCDB1051c3a003D5Fd19286Acd41f6117B6263BE5

# Optional custom RPC
RPC_URL=https://bsc-testnet.publicnode.com
